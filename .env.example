# Configuración del correo - Copiar como .env y completar
# Gmail: usar contraseña de aplicación (https://myaccount.google.com/apppasswords)
# Outlook: usar contraseña de aplicación
# Mailgun, SendGrid, etc. también funcionan

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
EMAIL_TO=destinatario@email.com
PORT=3000
